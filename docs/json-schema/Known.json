{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Known",
  "description": "A change as `switch` lists it: Go's `KnownChange`.",
  "type": "object",
  "required": [
    "gates",
    "id",
    "loop",
    "name",
    "phase",
    "repos",
    "status"
  ],
  "properties": {
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "id": {
      "description": "The folder's leading number; 0 for a change without one.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "loop": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}
