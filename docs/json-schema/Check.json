{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Check",
  "description": "What [`check`] found. `present` is false when there's no `references/` folder.",
  "type": "object",
  "required": [
    "files",
    "findings",
    "indexed",
    "present"
  ],
  "properties": {
    "files": {
      "description": "Files in the room, not counting `index.md`, `context.md` and dotfiles.",
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Finding"
      }
    },
    "indexed": {
      "description": "How many of them the index lists.",
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "present": {
      "type": "boolean"
    }
  },
  "definitions": {
    "Finding": {
      "description": "One warning from [`check`].",
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        }
      }
    }
  }
}
