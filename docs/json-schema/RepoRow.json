{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoRow",
  "description": "One line of `repo list`.",
  "type": "object",
  "required": [
    "archived",
    "archivedReason",
    "branch",
    "name",
    "remote"
  ],
  "properties": {
    "archived": {
      "description": "Archived: kept in the registry, but not cloned or given new work.",
      "type": "boolean"
    },
    "archivedReason": {
      "description": "Why it was archived, or empty.",
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "description": "The path as stored in `paths.json` (a `~/` path unexpanded), if any.",
      "type": [
        "string",
        "null"
      ]
    },
    "remote": {
      "type": "string"
    }
  }
}
