{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Success_for_Record",
  "description": "A successful read: `data` is the serialised core value the command reads.",
  "type": "object",
  "required": [
    "data",
    "schema",
    "warnings"
  ],
  "properties": {
    "data": {
      "$ref": "#/definitions/Record"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "warnings": {
      "description": "The operation's warnings, in order: what the text form prints to stderr as `warning: <message>`, without the prefix. Always present; empty when there are none.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "Record": {
      "description": "One decision record.",
      "type": "object",
      "required": [
        "date",
        "deciders",
        "file",
        "number",
        "path",
        "raw",
        "slug",
        "status",
        "title"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "deciders": {
          "$ref": "#/definitions/Text"
        },
        "file": {
          "description": "The file's name.",
          "type": "string"
        },
        "number": {
          "type": "integer",
          "format": "int64"
        },
        "path": {
          "description": "As shown: the root joined with the ADR folder and file name.",
          "type": "string"
        },
        "raw": {
          "description": "The file's bytes as they are, valid UTF-8 or not (`adr show` prints them). Serialised as a string with U+FFFD for invalid bytes, as Go's `encoding/json` writes its `Raw`.",
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "description": "As the file holds it (`adr list` prints it).",
          "allOf": [
            {
              "$ref": "#/definitions/Text"
            }
          ]
        }
      }
    },
    "Text": {
      "type": "string"
    }
  }
}
