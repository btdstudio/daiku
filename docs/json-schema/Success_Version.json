{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Success_for_Version",
  "description": "A successful read: `data` is the serialised core value the command reads.",
  "type": "object",
  "required": [
    "data",
    "schema"
  ],
  "properties": {
    "data": {
      "$ref": "#/definitions/Version"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "Version": {
      "description": "A read command's version string (`version --json`).",
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        }
      }
    }
  }
}
