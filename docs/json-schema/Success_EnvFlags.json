{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Success_for_EnvFlags",
  "description": "A successful read: `data` is the serialised core value the command reads.",
  "type": "object",
  "required": [
    "data",
    "schema",
    "warnings"
  ],
  "properties": {
    "data": {
      "$ref": "#/definitions/EnvFlags"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "warnings": {
      "description": "The operation's warnings, in order: what the text form prints to stderr as `warning: <message>`, without the prefix. Always present; empty when there are none.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "EnvFlags": {
      "description": "A read command's environment flags (`env --json`).",
      "type": "object",
      "required": [
        "flags"
      ],
      "properties": {
        "flags": {
          "type": "string"
        }
      }
    }
  }
}
