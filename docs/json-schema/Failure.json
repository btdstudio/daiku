{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Failure",
  "description": "A failed read command.",
  "type": "object",
  "required": [
    "error",
    "schema"
  ],
  "properties": {
    "error": {
      "$ref": "#/definitions/ErrorBody"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "ErrorBody": {
      "description": "The typed error carried in a [`Failure`].",
      "type": "object",
      "required": [
        "kind",
        "message"
      ],
      "properties": {
        "kind": {
          "description": "The stable `Error` variant name.",
          "type": "string"
        },
        "message": {
          "description": "The error's display text (what the CLI would print without `--json`).",
          "type": "string"
        }
      }
    }
  }
}
