          "required": [
            "active",
            "change",
            "kind",
            "loop",
            "phase"
          ],
          "properties": {
            "active": {
              "type": "boolean"
            },
            "change": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "approve"
              ]
            },
            "loop": {
              "type": "string"
            },
            "phase": {
              "type": "string"
            },
            "since": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "The change's next phase hasn't started.",
          "type": "object",
          "required": [
            "active",
            "change",
            "kind",
            "loop",
            "phase"
          ],
          "properties": {
            "active": {
              "type": "boolean"
            },
            "change": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "start"
              ]
            },
            "loop": {
              "type": "string"
            },
            "phase": {
              "type": "string"
            },
            "since": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "A ticket ready to build.",
          "type": "object",
          "required": [
            "change",
            "kind",
            "repo",
            "ticket",
            "title"
          ],
          "properties": {
            "change": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "build"
              ]
            },
            "repo": {
              "type": "string"
            },
            "since": {
              "type": [
                "string",
                "null"
              ]
            },
            "ticket": {
              "type": "string"
            },
            "title": {
              "$ref": "#/definitions/Text"
            }
          }
        }
      ]
    },
    "NextList": {
      "description": "What is waiting, first to last.",
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
