{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Success_for_Array_of_Idea",
  "description": "A successful read: `data` is the serialised core value the command reads.",
  "type": "object",
  "required": [
    "data",
    "schema"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Idea"
      }
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "Idea": {
      "description": "One idea, read from its `summary.md`.",
      "type": "object",
      "required": [
        "body",
        "changes",
        "dir",
        "id",
        "reason",
        "slug",
        "status",
        "title",
        "updated"
      ],
      "properties": {
        "body": {
          "description": "`summary.md` below its frontmatter, as bytes (`idea promote` copies it).",
          "allOf": [
            {
              "$ref": "#/definitions/Text"
            }
          ]
        },
        "changes": {
          "description": "The changes promoted from it, in order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dir": {
          "description": "`ideas/<n>-<slug>`, slash-separated, relative to the root.",
          "type": "string"
        },
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "reason": {
          "$ref": "#/definitions/Text"
        },
        "slug": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "description": "As the summary holds it (`idea list` prints it).",
          "allOf": [
            {
              "$ref": "#/definitions/Text"
            }
          ]
        },
        "updated": {
          "description": "`YYYY-MM-DD`.",
          "type": "string"
        }
      }
    },
    "Text": {
      "type": "string"
    }
  }
}
