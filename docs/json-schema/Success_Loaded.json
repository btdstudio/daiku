{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Success_for_Loaded",
  "description": "A successful read: `data` is the serialised core value the command reads.",
  "type": "object",
  "required": [
    "data",
    "schema",
    "warnings"
  ],
  "properties": {
    "data": {
      "$ref": "#/definitions/Loaded"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "warnings": {
      "description": "The operation's warnings, in order: what the text form prints to stderr as `warning: <message>`, without the prefix. Always present; empty when there are none.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "Loaded": {
      "type": "object",
      "required": [
        "effective",
        "global",
        "project",
        "vcs"
      ],
      "properties": {
        "effective": {
          "$ref": "#/definitions/Settings"
        },
        "global": {
          "description": "The global settings file's contents, unchanged, including keys daiku doesn't use; empty when there's no file.",
          "type": "object",
          "additionalProperties": true
        },
        "project": {
          "description": "The project settings file's contents, unchanged, including keys daiku doesn't use; empty when there's no file.",
          "type": "object",
          "additionalProperties": true
        },
        "vcs": {
          "type": "string"
        }
      }
    },
    "Settings": {
      "description": "The effective settings.",
      "type": "object",
      "required": [
        "adrDir",
        "baseSource",
        "gates",
        "overview",
        "sourceDir",
        "syncFile"
      ],
      "properties": {
        "adrDir": {
          "type": "string"
        },
        "baseSource": {
          "type": "string"
        },
        "gates": {
          "type": "string"
        },
        "overview": {
          "type": "string"
        },
        "sourceDir": {
          "type": "string"
        },
        "syncFile": {
          "type": "string"
        }
      }
    }
  }
}
