{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Success_for_Loaded",
  "description": "A successful read: `data` is the serialised core value the command reads.",
  "type": "object",
  "required": [
    "data",
    "schema"
  ],
  "properties": {
    "data": {
      "$ref": "#/definitions/Loaded"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "Loaded": {
      "type": "object",
      "required": [
        "effective",
        "global",
        "project",
        "vcs"
      ],
      "properties": {
        "effective": {
          "$ref": "#/definitions/Settings"
        },
        "global": {
          "type": "object",
          "additionalProperties": true
        },
        "project": {
          "type": "object",
          "additionalProperties": true
        },
        "vcs": {
          "type": "string"
        }
      }
    },
    "Settings": {
      "description": "The effective settings.",
      "type": "object",
      "required": [
        "adr_dir",
        "base_source",
        "gates",
        "overview",
        "source_dir",
        "sync_file"
      ],
      "properties": {
        "adr_dir": {
          "type": "string"
        },
        "base_source": {
          "type": "string"
        },
        "gates": {
          "type": "string"
        },
        "overview": {
          "type": "string"
        },
        "source_dir": {
          "type": "string"
        },
        "sync_file": {
          "type": "string"
        }
      }
    }
  }
}
