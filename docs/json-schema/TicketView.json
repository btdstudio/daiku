{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TicketView",
  "description": "One ticket as a client shows it: its fields, where it came from, and its body.",
  "type": "object",
  "required": [
    "body",
    "change",
    "changeClosed",
    "dependsOn",
    "drifted",
    "external",
    "frozen",
    "id",
    "inbox",
    "labels",
    "parent",
    "path",
    "repo",
    "requirements",
    "status",
    "title",
    "type"
  ],
  "properties": {
    "body": {
      "description": "The file's body, as its bytes (ADR-0004, ADR-0008).",
      "allOf": [
        {
          "$ref": "#/definitions/Text"
        }
      ]
    },
    "change": {
      "description": "The plan folder the ticket was loaded from; empty for an inbox ticket.",
      "type": "string"
    },
    "changeClosed": {
      "description": "The plan's status is `closed`.",
      "type": "boolean"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drifted": {
      "type": "boolean"
    },
    "external": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "frozen": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "inbox": {
      "description": "Loaded from `build/tickets/`.",
      "type": "boolean"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent": {
      "type": "string"
    },
    "path": {
      "description": "Relative to the workspace, slash-separated.",
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "definitions": {
    "Text": {
      "type": "string"
    }
  }
}
