{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Success_for_Array_of_Known",
  "description": "A successful read: `data` is the serialised core value the command reads.",
  "type": "object",
  "required": [
    "data",
    "schema",
    "warnings"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Known"
      }
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "warnings": {
      "description": "The operation's warnings, in order: what the text form prints to stderr as `warning: <message>`, without the prefix. Always present; empty when there are none.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "Known": {
      "description": "A change as `switch` lists it: Go's `KnownChange`.",
      "type": "object",
      "required": [
        "gates",
        "id",
        "loop",
        "name",
        "phase",
        "repos",
        "status"
      ],
      "properties": {
        "gates": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "id": {
          "description": "The folder's leading number; 0 for a change without one.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "loop": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        }
      }
    }
  }
}
