{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Change",
  "description": "One change's progress through its loop. `gates` holds only started phases.",
  "type": "object",
  "required": [
    "gates",
    "loop",
    "name",
    "phase",
    "reasons",
    "repos",
    "sources",
    "status",
    "updatedAt"
  ],
  "properties": {
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "loop": {
      "description": "`plan` or `build`; empty for a change that isn't recorded or found.",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "reasons": {
      "description": "Why each skipped phase was skipped.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "repos": {
      "description": "Logical repo names from `REPOS.json`.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
