{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Success_for_StatusReport",
  "description": "A successful read: `data` is the serialised core value the command reads.",
  "type": "object",
  "required": [
    "data",
    "schema"
  ],
  "properties": {
    "data": {
      "$ref": "#/definitions/StatusReport"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "Bucket": {
      "type": "object",
      "required": [
        "ids",
        "name"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Problem": {
      "description": "One thing wrong with a ticket.",
      "type": "object",
      "required": [
        "id",
        "message",
        "reference"
      ],
      "properties": {
        "id": {
          "description": "The ticket, or its path if the id isn't usable.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "reference": {
          "description": "For a missing reference, the id it names.",
          "type": "string"
        }
      }
    },
    "StatusReport": {
      "description": "`tickets status`: each bucket in Go's order with its sorted ids, and the files that couldn't be read.",
      "type": "object",
      "required": [
        "buckets",
        "unreadable"
      ],
      "properties": {
        "buckets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Bucket"
          }
        },
        "unreadable": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Problem"
          }
        }
      }
    }
  }
}
