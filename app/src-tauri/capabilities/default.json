{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core defaults, the folder picker, dragging the window by its title bar, and opening https: links in the browser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "core:window:allow-start-dragging",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }] }
  ]
}
